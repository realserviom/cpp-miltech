{
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modifications",
    "C_Cpp.clang_format_style": "file",
    "cmake-format.exePath": "cmake-format",
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp"
    },
    // 1. Вмикаємо сам двигун аналізу
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    // 2. Вказуємо використовувати файл конфігурації (як і для формату)
    "C_Cpp.codeAnalysis.clangTidy.configSource": "file",
    // 3. Опціонально: вказуємо шлях до екзешника, якщо він не в PATH
    // "C_Cpp.codeAnalysis.clangTidy.path": "шлях/до/clang-tidy",
    // 4. Дозволяємо перевірку під час редагування
    "C_Cpp.codeAnalysis.runAutomatically": true
}