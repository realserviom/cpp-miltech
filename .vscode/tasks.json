{
  // VS Code tasks виконуються з кореня workspace у devcontainer terminal.
  // Тут лишаються тільки базові команди: configure/build і clean.
  "version": "2.0.0",
  "tasks": [
    {
      // Default build task: Ctrl+Shift+B запускає debug preset, потім build.
      "label": "CMake: configure and build",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // Clean task навмисно простий: видаляється тільки локальна build директорія.
      "label": "CMake: clean build directory",
      "type": "shell",
      "command": "rm -rf build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run Quality Check (All)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check-all.sh",
      "args": [
        "${input:homeworkFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Check Format",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check-format.sh",
      "args": [
        "${input:homeworkFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Check Quality",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check-quality.sh",
      "args": [
        "${input:homeworkFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Check Test",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check-test.sh",
      "args": [
        "${input:homeworkFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true,
        "close": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "homeworkFolder",
      "type": "promptString",
      "description": "Введіть назву папки (напр. homework_06)",
      "default": "homework_06"
    }
  ]
}